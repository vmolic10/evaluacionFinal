<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".VerAcciones"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvusuacciones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:hint="Nombre Usuario"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvtitacc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="Verificación del sensor"
        android:textSize="28sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/ivacciones"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:scaleType="fitCenter"
        app:srcCompat="@drawable/img" />

    <TextView
        android:id="@+id/tvdistancia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="-- cm"
        android:textSize="44sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvestadosensor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="Esperando datos del ESP32..."
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvdetalle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="Detecciones: 0   Última: --"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvestadoesp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="ESP32: conectando..."
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvhistorial"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="Historial (acciones y avisos del sensor)"
        android:textSize="18sp"
        android:textStyle="bold" />

    <ListView
        android:id="@+id/lvacciones"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/btnvolacc"
        android:layout_width="350dp"
        android:layout_height="60dp"
        android:layout_gravity="center"
        android:backgroundTint="@android:color/holo_red_dark"
        android:text="Volver"
        android:textSize="24sp"
        android:textStyle="bold" />
</LinearLayout>
